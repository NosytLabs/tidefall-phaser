{
  "name": "tidefall-phaser",
  "version": "1.0.0",
  "type": "module",
  "description": "Tidefall - 2D top-down fishing game built with Phaser 3",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "analyze": "vite build --mode analyze && node scripts/analyze-bundle.js",
    "test": "node tests/unit-test.js",
    "test:e2e": "npx playwright test tests/e2e.spec.js",
    "test:e2e:ci": "npx playwright test --config playwright.config.js",
    "test:all": "npm test && npm run test:e2e:ci"
  },
  "dependencies": {
    "phaser": "^3.85.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.1",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^6.4.3"
  }
}
